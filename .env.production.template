# Coin Railz Production Environment Configuration
# Copy this file to .env.production and configure with your actual values

# ===== REQUIRED FOR PRODUCTION DEPLOYMENT =====

# Application Environment
NODE_ENV=production
PORT=5000

# Domain Configuration (CRITICAL)
REPLIT_DOMAINS=coinrailz.com,www.coinrailz.com
FRONTEND_URL=https://coinrailz.com
BACKEND_URL=https://coinrailz.com

# Database (REQUIRED - Production PostgreSQL)
DATABASE_URL=postgresql://username:password@host:port/database
PGHOST=your_postgres_host
PGPORT=5432
PGUSER=your_postgres_user
PGPASSWORD=your_postgres_password
PGDATABASE=coinrailz_production

# Authentication (REQUIRED - General User Registration)
SESSION_SECRET=your_256_bit_session_secret_key

# Optional - Replit OAuth (for Replit users only)
REPLIT_CLIENT_ID=your_replit_oauth_client_id
REPLIT_CLIENT_SECRET=your_replit_oauth_client_secret
ISSUER_URL=https://replit.com/oidc

# Payment Processing (REQUIRED - Stripe Production)
STRIPE_SECRET_KEY=sk_live_your_production_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret
VITE_STRIPE_PUBLIC_KEY=pk_live_your_production_stripe_public_key

# ===== CRYPTOCURRENCY INTEGRATIONS =====

# Blockchain Network APIs
INFURA_PROJECT_ID=your_infura_project_id
ALCHEMY_API_KEY=your_alchemy_api_key
QUICKNODE_ENDPOINT=your_quicknode_endpoint

# Cryptocurrency Price APIs
COINGECKO_API_KEY=your_coingecko_api_key
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# ===== OPTIONAL SERVICES =====

# Notification Services
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
SENDGRID_API_KEY=your_sendgrid_api_key

# Banking APIs (Optional)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret_key
PLAID_ENVIRONMENT=production

# Compliance & KYC (Optional)
JUMIO_API_TOKEN=your_jumio_api_token
JUMIO_API_SECRET=your_jumio_api_secret
JUMIO_BASE_URL=https://netverify.com

# Redis Cache (Recommended for scaling)
REDIS_URL=redis://your_redis_host:6379

# Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_for_error_tracking

# ===== XRP LEDGER CONFIGURATION =====
XRP_WALLET_ADDRESS=your_production_xrp_wallet_address
XRP_WALLET_SECRET=your_production_xrp_wallet_secret