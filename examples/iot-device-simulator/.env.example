# Coin Railz IoT Device Simulator Configuration

# Your IoT API key (get from https://coinrailz.com/iot)
COINRAILZ_API_KEY=iot_your_api_key_here

# API base URL (use https://coinrailz.com for production)
COINRAILZ_BASE_URL=https://coinrailz.com

# Unique device identifier
DEVICE_ID=weather-station-001
