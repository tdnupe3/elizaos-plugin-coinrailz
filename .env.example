# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/coinrailz
PGHOST=localhost
PGPORT=5432
PGUSER=username
PGPASSWORD=password
PGDATABASE=coinrailz

# Authentication & Security
SESSION_SECRET=your-super-secure-session-secret-here
REPLIT_DOMAINS=your-domain.replit.app,coinrailz.com
REPL_ID=your-repl-id
ISSUER_URL=https://replit.com/oidc

# Stripe Payment Processing
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key_here

# Cryptocurrency APIs
COINBASE_API_KEY=your_coinbase_pro_api_key
COINBASE_API_SECRET=your_coinbase_pro_api_secret
COINBASE_PASSPHRASE=your_coinbase_pro_passphrase
COINGECKO_API_KEY=your_coingecko_api_key
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# Banking & Payment APIs
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret_key
PLAID_ENVIRONMENT=sandbox
DWOLLA_KEY=your_dwolla_key
DWOLLA_SECRET=your_dwolla_secret
DWOLLA_ENVIRONMENT=sandbox

# Compliance & KYC
JUMIO_API_TOKEN=your_jumio_api_token
JUMIO_API_SECRET=your_jumio_api_secret
JUMIO_BASE_URL=https://netverify.com
CHAINALYSIS_API_KEY=your_chainalysis_api_key

# Blockchain Network APIs
INFURA_PROJECT_ID=your_infura_project_id
ALCHEMY_API_KEY=your_alchemy_api_key
QUICKNODE_ENDPOINT=your_quicknode_endpoint

# Notification Services
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
SENDGRID_API_KEY=your_sendgrid_api_key

# Application Environment
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Redis Cache (for production scaling)
REDIS_URL=redis://localhost:6379

# Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_for_error_tracking

# Circle USDC Integration
CIRCLE_API_KEY=your_circle_api_key_here
CIRCLE_ENTITY_SECRET=your_circle_entity_secret_here

# Plaid Bank Connectivity Integration (Pay-as-You-Go Program Approved)
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here
PLAID_ENV=sandbox